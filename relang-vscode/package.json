{
  "name": "relang-vscode",
  "displayName": "ReLang",
  "description": "Language support for ReLang - a resumable programming language",
  "version": "0.1.0",
  "publisher": "relang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:relang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "relang",
        "aliases": ["ReLang", "relang"],
        "extensions": [".re"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "relang",
        "scopeName": "source.relang",
        "path": "./syntaxes/relang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ReLang",
      "properties": {
        "relang.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol support"
        },
        "relang.java.home": {
          "type": "string",
          "default": "",
          "description": "Path to GraalVM Java home (uses JAVA_HOME if not set)"
        },
        "relang.lsp.port": {
          "type": "number",
          "default": 8123,
          "description": "Port for the LSP server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "copy-grammar": "cp -r ../relang-textmate/syntaxes ./syntaxes && cp ../relang-textmate/language-configuration.json ./language-configuration.json"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
