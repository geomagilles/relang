{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ReLang",
  "scopeName": "source.relang",
  "fileTypes": ["re"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#type-declarations" },
    { "include": "#keywords" },
    { "include": "#type-names" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.relang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.relang",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.relang" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.bytes.relang",
          "begin": "b\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.relang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.relang" } },
          "patterns": [
            {
              "name": "constant.character.escape.relang",
              "match": "\\\\(x[0-9a-fA-F]{2}|\\\\|\")"
            }
          ]
        },
        {
          "name": "string.quoted.double.relang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.relang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.relang" } },
          "patterns": [
            {
              "name": "constant.character.escape.relang",
              "match": "\\\\[ntr\\\\\"$]"
            },
            {
              "name": "meta.interpolation.relang",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.relang" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.relang" } },
              "patterns": [
                { "include": "source.relang" }
              ]
            }
          ]
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.relang" },
            "2": { "name": "entity.name.type.relang" }
          }
        },
        {
          "match": "\\b(sealed)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.relang" },
            "2": { "name": "entity.name.type.relang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.relang",
          "match": "\\b(if|else|while|return|for|in|match|await|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.function.relang",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "keyword.declaration.relang",
          "match": "\\b(let)\\b"
        },
        {
          "name": "keyword.other.checkpoint.relang",
          "match": "\\b(checkpoint)\\b"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "support.type.relang",
          "match": "\\b(Int|Float|Bool|String|Unit|None|Bytes|Duration|Timestamp|Json|Failure)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.relang",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.function.relang" },
            "2": { "name": "entity.name.function.relang" }
          }
        },
        {
          "name": "meta.function.call.relang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.relang" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.duration.relang",
          "match": "\\b[0-9]+(?:ms|min|s|h)\\b"
        },
        {
          "name": "constant.numeric.float.relang",
          "match": "\\b[0-9]([0-9_]*[0-9])?\\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.relang",
          "match": "\\b[0-9]([0-9_]*[0-9])?\\b"
        },
        {
          "name": "constant.language.boolean.relang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.relang",
          "match": "\\b(none|unit)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.relang",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.range.relang",
          "match": "\\.\\.(=)?"
        },
        {
          "name": "keyword.operator.arrow.relang",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.relang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.relang",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.relang",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.product.relang",
          "match": "&"
        },
        {
          "name": "keyword.operator.union.relang",
          "match": "\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.relang",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.relang",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.relang",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.relang",
          "match": ";"
        },
        {
          "name": "punctuation.section.block.begin.relang",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.relang",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.relang",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.relang",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.relang",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.relang",
          "match": "\\]"
        },
        {
          "name": "constant.language.wildcard.relang",
          "match": "\\b_\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.relang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
