{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ReLang",
  "scopeName": "source.relang",
  "fileTypes": ["re"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.relang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.relang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.relang",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.other.checkpoint.relang",
          "match": "\\b(checkpoint)\\b"
        },
        {
          "name": "keyword.declaration.function.relang",
          "match": "\\b(fn)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.relang",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.function.relang" },
            "2": { "name": "entity.name.function.relang" }
          }
        },
        {
          "name": "meta.function.call.relang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.relang" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.integer.relang",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.relang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.relang",
          "match": "(==|<)"
        },
        {
          "name": "keyword.operator.assignment.relang",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.relang",
          "match": "[+\\-*/]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.relang",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.relang",
          "match": ";"
        },
        {
          "name": "punctuation.section.block.begin.relang",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.relang",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.relang",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.relang",
          "match": "\\)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.relang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
